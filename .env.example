# === LLM API ===
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# === Database ===
# Docker: db / 로컬: localhost
DATABASE_URL=postgresql+asyncpg://lawdoctor:lawdoctor_pass@db:5432/lawdoctor
POSTGRES_USER=lawdoctor
POSTGRES_PASSWORD=lawdoctor_pass
POSTGRES_DB=lawdoctor

# === ChromaDB ===
# Docker: chromadb / 로컬: localhost
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# === 국가법령정보센터 API ===
LAW_API_KEY=your-law-api-key-here

# === App Settings ===
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
# Docker: http://frontend / 로컬: http://localhost:5173
FRONTEND_URL=http://frontend

# === Security ===
# 쉼표로 구분된 허용 IP 목록 (사내 네트워크)
ALLOWED_IPS=127.0.0.1,192.168.0.0/24,10.0.0.0/8
SECRET_KEY=your-secret-key-change-in-production

# === Upload ===
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
UPLOAD_CLEANUP_HOURS=24
